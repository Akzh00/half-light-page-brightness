{
  "manifest_version": 3,
  "name": "Half-light: Page Brightness",
  "version": "1.0.1",
  "description": "Dim or brighten web pages with a simple slider.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Half-light: Page Brightness",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "brighter": {
      "suggested_key": {
        "default": "Alt+Shift+Up"
      },
      "description": "Make pages brighter"
    },
    "darker": {
      "suggested_key": {
        "default": "Alt+Shift+Down"
      },
      "description": "Make pages darker"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
